# 运行数据、模型、凭据和生成产物不得进入构建上下文
.env
.env.*
data/
models/
sentinel/
tmp/
workspace/
workspaces/
assets/
runtime/
*.db
*.db-*
*.sqlite
*.sqlite3
*.log
*.coverage
coverage.xml
htmlcov/
evals/reports/

# 宿主运维、构建与测试输入不进入 Runtime 镜像。Prompt Runtime 的镜像内
# 验证入口按文件白名单保留。
docker-compose*.yml
package*.json
requirements-sandbox*
requirements-test*
requirements.txt
scripts/*
!scripts/build_release_manifest.py
!scripts/manage_prompt_templates.py
!scripts/verify_prompt_runtime_release.py
