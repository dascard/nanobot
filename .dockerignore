**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
**/.ruff_cache/
node_modules/
**/node_modules/
webui/dist/
webui/data/

# 测试、文档和仅供开发使用的项目
tests/
vendor/KohakuTerrarium/tests/
vendor/KohakuTerrarium/build/
docs/
deploy/
docker/
design-system/
cc2codex/
