#include <tunables/global>

profile nanobot-sandbox flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  deny network,
  deny mount,
  deny umount,
  deny pivot_root,
  deny ptrace,
  deny capability,

  /bin/** ixr,
  /usr/bin/** ixr,
  /usr/local/bin/python* ixr,
  /usr/local/lib/libpython3.11.so.1.0 mr,
  /usr/local/lib/python3.11/ r,
  /usr/local/lib/python3.11/** mr,
  /lib/** mr,
  /usr/lib/** mr,

  /etc/** r,
  /proc/** r,
  /sys/devices/system/cpu/** r,
  /dev/null rw,
  /dev/zero rw,
  /dev/random r,
  /dev/urandom r,

  /workspace/ rw,
  /workspace/** rwklix,
  /runtime/ rw,
  /runtime/** rwklix,
  /inputs/ r,
  /inputs/** rix,
  /tmp/ rw,
  /tmp/** rwkl,

  deny /var/run/docker.sock rw,
  deny /run/docker.sock rw,
}
