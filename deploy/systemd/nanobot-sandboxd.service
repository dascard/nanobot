[Unit]
Description=Nanobot 宿主 Sandbox Docker 控制面
Documentation=file:/opt/nanobot-server/docs/sandbox-operations.md
Requires=docker.service
After=docker.service local-fs.target
RequiresMountsFor=/srv/nanobot
ConditionPathExists=/var/run/docker.sock
ConditionPathExists=/etc/nanobot/sandbox-execution-profiles.v1.json
ConditionPathIsMountPoint=/srv/nanobot

[Service]
Type=simple
User=root
Group=nanobot-sandboxd
WorkingDirectory=/opt/nanobot-server
EnvironmentFile=/etc/nanobot/sandboxd.env
ExecStartPre=/usr/bin/test -S /var/run/docker.sock
ExecStartPre=/usr/bin/mountpoint -q /srv/nanobot
ExecStartPre=/usr/bin/install -m 0640 -o root -g nanobot-sandboxd /etc/nanobot/sandbox-execution-profiles.v1.json /run/nanobot-sandboxd/profile-manifest.json
ExecStart=/opt/nanobot-sandboxd/venv/bin/python -m sandboxd.app
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
KillMode=mixed
UMask=0117

RuntimeDirectory=nanobot-sandboxd
RuntimeDirectoryMode=0750
# Server 以 bind mount 读取该目录。即使 Smoke 显式 stop/start sandboxd，也必须
# 保留同一 inode，避免容器继续挂载已删除的旧目录。
RuntimeDirectoryPreserve=yes
ReadWritePaths=/srv/nanobot /run/nanobot-sandboxd
ReadOnlyPaths=/opt/nanobot-server /etc/nanobot/sandboxd.token /etc/nanobot/sandboxd-admin.token /etc/nanobot/sandbox-execution-profiles.v1.json /var/run/docker.sock
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
PrivateMounts=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_ADMIN
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
