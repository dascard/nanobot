# Dify 引擎连接配置
DIFY_BASE_URL=http://dify-api:5001/v1
API_KEY_01_CHAT=app-xxxxxxxxxxxxxxxxxxxxxxxx
API_KEY_02_LOG=app-xxxxxxxxxxxxxxxxxxxxxxxx
API_KEY_03_PERSONA=app-xxxxxxxxxxxxxxxxxxxxxxxx
API_KEY_04_AUDIT=app-xxxxxxxxxxxxxxxxxxxxxxxx

# 触发后台自进化的积攒对话对条数阈值
EVOLUTION_THRESHOLD=20

# 可选：配置简单的 Bearer Token 校验，拦截未授权的伪造请求
# 如果为空则禁用 API 鉴权，支持 Tampermonkey 裸连
NANOBOT_API_TOKEN=

# Dify 容错重试策略
DIFY_MAX_RETRIES=3
DIFY_RETRY_BASE_DELAY=2.0
DIFY_REQUEST_TIMEOUT=180

# 数据库存储
DATABASE_URL=sqlite:///./data/nanobot.db

# 日志输出配置
LOG_DIR=./data
LOG_LEVEL=INFO

# New-API 网关（可选）
LLM_PROVIDER=new-api
NEW_API_BASE_URL=https://api.new-api.com/v1
NEW_API_KEY=
NEW_API_TIMEOUT=300
NEW_API_AUTO_MODEL_SYNC=1
NEW_API_MODEL_SYNC_INTERVAL_MINUTES=60

# QQbot 反向推送地址（nanobot-server -> QQbot）
QQBOT_PUSH_URL=http://172.17.0.1:8082/nanobot/push

# 自动模型路由：off | code | model
AUTO_MODEL_ROUTING_MODE=code
