# 基础运行配置
DATABASE_URL=sqlite:///./data/nanobot.db
LOG_DIR=./data
LOG_LEVEL=INFO
NANOBOT_CORS_ORIGINS=*

# 鉴权与权限。敏感值只在未纳入版本控制的实际环境中填写
NANOBOT_API_TOKEN=
NANOBOT_ADMIN_TOKEN=
NANOBOT_SUPER_USER_IDS=

# New-API 网关与模型路由
LLM_PROVIDER=new-api
NEW_API_BASE_URL=https://api.new-api.com/v1
NEW_API_KEY=
NEW_API_TIMEOUT=300
NEW_API_MAX_RETRIES=3
NEW_API_AUTO_MODEL_SYNC=1
NEW_API_MODEL_SYNC_INTERVAL_MINUTES=60
LLM_MODEL_REPLY=deepseek-v4-flash-max
LLM_MODEL_FAST=
LLM_MODEL_SESSION_SUMMARY=
LLM_MODEL_SMART=

# 本地 Qwen 分类器与 Sentinel
CLASSIFIER_API_URL=http://172.17.0.1:9999/v1
SENTINEL_MODEL_PATH=./sentinel

# 记忆折叠与独立 worker
MEMORY_DIGEST_SCHEDULER_ENABLED=1
MEMORY_DIGEST_SCHEDULE_HOUR=4
MEMORY_DIGEST_LLM_ENABLED=1
NANOBOT_SESSION_SUMMARY_WORKER_MODE=embedded
SEMANTIC_INDEX_ENABLED=1
RAG_EMBEDDING_PROVIDER=

# Prompt Runtime
NANOBOT_PROMPT_ENGINE=prompt
NANOBOT_PROMPT_DEFAULT_DIR=./prompts.v2.default
NANOBOT_PROMPT_RUNTIME_DIR=./data/prompts_v2

# QQ 反向推送
NANOBOT_PUSH_TOKEN=
QQBOT_PUSH_URL=http://172.17.0.1:8082/nanobot/push
QQBOT_PUSH_TIMEOUT=180
NANOBOT_QQ_PUSH_CONFIG_REVISION=1
NANOBOT_OUTBOUND_BATCH_SIZE=20
NANOBOT_OUTBOUND_LEASE_SECONDS=240
NANOBOT_OUTBOUND_POLL_INTERVAL=1
NANOBOT_SCHEDULED_TASK_CLAIM_LEASE_SECONDS=900
NANOBOT_SCHEDULED_TASK_WRITER_LEASE_SECONDS=900
NANOBOT_OUTBOUND_MAX_ATTEMPTS=3
NANOBOT_OUTBOUND_RETRY_DEADLINE_SECONDS=86400

# 图片生成与公开访问
IMAGE_GENERATION_MODEL=gpt-image
IMAGE_GENERATION_TIMEOUT=600
IMAGE_GENERATION_PROMPT_MAX_CHARS=4000
IMAGE_GENERATION_OUTPUT_DIR=./data/generated_images
IMAGE_GENERATION_TTL_DAYS=14
IMAGE_GENERATION_MAX_FILES=500
NANOBOT_PUBLIC_BASE_URL=http://localhost:8000
# Sandbox 资产下载 HMAC 密钥至少 32 字节；生产环境使用随机值并妥善保管。
NANOBOT_ASSET_TOKEN_SECRET=
NANOBOT_ASSET_TOKEN_TTL_SECONDS=300
NANOBOT_SANDBOX_RUN_TIMEOUT=165
NANOBOT_STICKER_IMAGE_TOKEN=
NANOBOT_GENERATED_IMAGE_TOKEN=

# 其他运行选项
EVOLUTION_THRESHOLD=20
AUTO_MODEL_ROUTING_MODE=code
NANOBOT_AGENT_STEP_MODEL=

# 构建元数据。Compose 会把 GIT_* 写入镜像内的 NANOBOT_GIT_*
# 不要在运行时环境中设置空的 NANOBOT_GIT_*，否则会覆盖镜像构建信息
GIT_COMMIT=
GIT_BRANCH=
GIT_FULL_COMMIT=
GIT_COMMIT_DATE=
GIT_DIRTY=
